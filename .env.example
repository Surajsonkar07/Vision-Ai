# All variables are optional. Without them VisionAI still detects objects
# in the browser and keeps history on the device.

# Supabase — accounts, cloud sync of scans, profile
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# OpenRouter — optional "Describe with AI" (free vision models)
OPENROUTER_API_KEY=

# Mailjet — e-mail OTP during sign-up
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
